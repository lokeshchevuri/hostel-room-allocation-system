{
  "name": "hostel-room-allocation-system",
  "version": "1.0.0",
  "description": "MERN Stack Hostel Room Allocation System for College Administration",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "server:dev": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix frontend",
    "seed": "node backend/seed.js"
  },
  "keywords": [
    "mern",
    "hostel",
    "allocation",
    "college"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
